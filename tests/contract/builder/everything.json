{
  "name": "builder-everything",
  "type": "builder",
  "input": {
    "model": {
      "version": 1,
      "root": {
        "type": "container",
        "direction": "column",
        "gap": 8,
        "padding": 0,
        "background": "",
        "children": [
          {
            "type": "image",
            "size": "medium_large",
            "link": true
          },
          {
            "type": "image",
            "size": "full",
            "link": false
          },
          {
            "type": "title",
            "tag": "h2",
            "link": false
          },
          {
            "type": "excerpt",
            "words": 30
          },
          {
            "type": "date",
            "format": "d.m.Y",
            "relative": false
          },
          {
            "type": "date",
            "format": "d.m.Y",
            "relative": true
          },
          {
            "type": "author",
            "link": false
          },
          {
            "type": "author",
            "link": true
          },
          {
            "type": "taxonomy",
            "taxonomy": "category",
            "links": true,
            "separator": ", "
          },
          {
            "type": "taxonomy",
            "taxonomy": "post_tag",
            "links": false,
            "separator": " | "
          },
          {
            "type": "meta",
            "key": "subtitle",
            "label": "",
            "fallback": ""
          },
          {
            "type": "meta",
            "key": "price",
            "label": "Price:",
            "fallback": "on request"
          },
          {
            "type": "readmore",
            "label": "Read more"
          },
          {
            "type": "text",
            "text": "Text"
          },
          {
            "type": "container",
            "direction": "row",
            "gap": 8,
            "padding": 0,
            "background": "#AABBCC",
            "children": [
              {
                "type": "title",
                "tag": "h3",
                "link": true
              },
              {
                "type": "spacer",
                "height": 16
              }
            ]
          }
        ]
      }
    }
  },
  "expect": {
    "html": "<article class=\"swp-b swp-b-n1\" data-swp-builder=\"\">{{#entry.image}}<a class=\"swp-b-image\" href=\"{{entry.url}}\">{{entry.image|image:\"medium_large\"}}</a>{{/entry.image}}{{#entry.image}}<div class=\"swp-b-image\">{{entry.image|image:\"full\"}}</div>{{/entry.image}}<h2 class=\"swp-b-title\">{{entry.title}}</h2>{{#entry.excerpt}}<p class=\"swp-b-excerpt\">{{entry.excerpt|words:30}}</p>{{/entry.excerpt}}<time class=\"swp-b-date\" datetime='{{entry.date|date:\"c\"}}'>{{entry.date|date:\"d.m.Y\"}}</time><time class=\"swp-b-date\" datetime='{{entry.date|date:\"c\"}}'>{{entry.date|relative_date}}</time><span class=\"swp-b-author\">{{entry.author.name}}</span><span class=\"swp-b-author\"><a href=\"{{entry.author.url}}\">{{entry.author.name}}</a></span>{{#entry.terms.category}}<p class=\"swp-b-terms\">{{entry.terms.category|link:\", \"}}</p>{{/entry.terms.category}}{{#entry.terms.post_tag}}<p class=\"swp-b-terms\">{{entry.terms.post_tag|join:\" | \"}}</p>{{/entry.terms.post_tag}}{{#entry.meta.subtitle}}<p class=\"swp-b-meta\">{{entry.meta.subtitle}}</p>{{/entry.meta.subtitle}}<p class=\"swp-b-meta\"><strong>Price:</strong> {{entry.meta.price|default:\"on request\"}}</p><a class=\"swp-b-more\" href=\"{{entry.url}}\">Read more</a><p class=\"swp-b-text\">Text</p><div class=\"swp-b-box swp-b-n2\"><h3 class=\"swp-b-title\"><a href=\"{{entry.url}}\">{{entry.title}}</a></h3><div class=\"swp-b-spacer swp-b-n3\" aria-hidden=\"true\"></div></div></article>",
    "css": ".swp-b img{display:block;max-width:100%;height:auto}\n.swp-b-title{margin:0}\n.swp-b p{margin:0}\n.swp-b-n1{display:flex;flex-direction:column;gap:8px;padding:0px;}\n.swp-b-n2{display:flex;flex-direction:row;gap:8px;padding:0px;background:#aabbcc;}\n.swp-b-n3{height:16px}"
  }
}
