{
  "name": "builder-default",
  "type": "builder",
  "input": {
    "model": {
      "version": 1,
      "root": {
        "type": "container",
        "direction": "column",
        "gap": 8,
        "padding": 0,
        "background": "",
        "children": [
          {
            "type": "image",
            "size": "medium_large",
            "link": true
          },
          {
            "type": "container",
            "direction": "column",
            "gap": 6,
            "padding": 12,
            "background": "",
            "children": [
              {
                "type": "title",
                "tag": "h3",
                "link": true
              },
              {
                "type": "date",
                "format": "d.m.Y",
                "relative": false
              },
              {
                "type": "excerpt",
                "words": 30
              },
              {
                "type": "readmore",
                "label": "Read more"
              }
            ]
          }
        ]
      }
    }
  },
  "expect": {
    "html": "<article class=\"swp-b swp-b-n1\" data-swp-builder=\"\">{{#entry.image}}<a class=\"swp-b-image\" href=\"{{entry.url}}\">{{entry.image|image:\"medium_large\"}}</a>{{/entry.image}}<div class=\"swp-b-box swp-b-n2\"><h3 class=\"swp-b-title\"><a href=\"{{entry.url}}\">{{entry.title}}</a></h3><time class=\"swp-b-date\" datetime='{{entry.date|date:\"c\"}}'>{{entry.date|date:\"d.m.Y\"}}</time>{{#entry.excerpt}}<p class=\"swp-b-excerpt\">{{entry.excerpt|words:30}}</p>{{/entry.excerpt}}<a class=\"swp-b-more\" href=\"{{entry.url}}\">Read more</a></div></article>",
    "css": ".swp-b img{display:block;max-width:100%;height:auto}\n.swp-b-title{margin:0}\n.swp-b p{margin:0}\n.swp-b-n1{display:flex;flex-direction:column;gap:8px;padding:0px;}\n.swp-b-n2{display:flex;flex-direction:column;gap:6px;padding:12px;}"
  }
}
