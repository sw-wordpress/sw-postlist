{
    "name": "sw/sw-postlist-wp-tests-65",
    "description": "WordPress 6.5 (minimum version) integration test environment, see composer test:wp65.",
    "type": "project",
    "require-dev": {
        "johnpbloch/wordpress-core": "6.5.*",
        "phpunit/phpunit": "^9.6",
        "wp-phpunit/wp-phpunit": "6.5.*",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload-dev": {
        "psr-4": {
            "SW\\Postlist\\": "../../src/",
            "SW\\Postlist\\Tests\\": "../"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "johnpbloch/wordpress-core-installer": true
        },
        "vendor-dir": "vendor-65"
    },
    "extra": {
        "wordpress-install-dir": "vendor-65/wordpress"
    },
    "minimum-stability": "stable"
}
