parameters:
    level: 8
    paths:
        - src
        - sw-postlist.php
        - uninstall.php
    bootstrapFiles:
        - tests/phpstan/bootstrap.php
    dynamicConstantNames:
        - SW_POSTLIST_VERSION
        - SW_POSTLIST_FILE
        - SW_POSTLIST_DIR
        - SW_POSTLIST_URL
        - SW_POSTLIST_MIN_PHP
    tmpDir: .phpstan.cache
