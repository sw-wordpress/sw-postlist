{
  "schema_version": 1,
  "id": "teaser-pills",
  "title": "Teaser with pills",
  "description": "Image tile on the left; date and category pills, upper case headline, excerpt and a dark button. Entries are separated by a thin line.",
  "layout": {
    "type": "list",
    "gap": {
      "desktop": 0,
      "tablet": 0,
      "mobile": 0
    },
    "aspect_ratio": "4/3"
  },
  "container": {
    "html": "<section class=\"tp\">{{view.filters}}<div class=\"swp-list\">{{view.entries}}</div>{{view.navigation}}</section>",
    "css": ".tp{container-type:inline-size}.tp .swp-item{padding:32px 0;border-bottom:1px solid #e6e6e1}.tp .swp-item:last-child{border-bottom:0}.tp .swp-filters{margin-bottom:8px}.tp .swp-list{gap:0}@container (max-width:560px){.tp-card{grid-template-columns:minmax(0,1fr)}}"
  },
  "entry": {
    "html": "<article class=\"tp-card\">{{#entry.image}}<a class=\"tp-card__media\" href=\"{{entry.url}}\">{{entry.image|image:\"medium\"}}</a>{{/entry.image}}{{^entry.image}}<a class=\"tp-card__media tp-card__media--ph\" href=\"{{entry.url}}\" aria-hidden=\"true\" tabindex=\"-1\"></a>{{/entry.image}}<div class=\"tp-card__body\"><div class=\"tp-card__pills\"><span class=\"tp-pill tp-pill--date\">{{entry.date|date:\"D, d. F Y\"}}</span>{{entry.terms.category|chips:\"tp-pill--cat\"}}</div><h3 class=\"tp-card__title\"><a href=\"{{entry.url}}\">{{entry.title}}</a></h3>{{#entry.excerpt}}<p class=\"tp-card__text\">{{entry.excerpt|words:30}}</p>{{/entry.excerpt}}<a class=\"tp-card__button\" href=\"{{entry.url}}\">Mehr erfahren <span aria-hidden=\"true\">→</span></a></div></article>",
    "css": ".tp-card{display:grid;grid-template-columns:minmax(0,220px) minmax(0,1fr);gap:40px;align-items:center}.tp-card__media{display:block;background:#f1efe6;border-radius:20px;padding:14px;overflow:hidden}.tp-card__media img{display:block;width:100%;height:auto;aspect-ratio:3/4;object-fit:cover;border-radius:10px}.tp-card__media--ph{min-height:260px;background:linear-gradient(135deg,#f1efe6 0 50%,#e5e0cf 50% 100%)}.tp-card__pills{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}.tp-pill,.tp-card .swp-chip{display:inline-block;padding:4px 12px;border-radius:8px;font-size:.78em;font-weight:700;line-height:1.5}.tp-pill--date{background:#fbe27a;color:#3d3300}.tp-card .swp-chip{background:#d9efd2;color:#27531b;text-transform:uppercase;letter-spacing:.04em;font-size:.7em}.tp-card__title{margin:0 0 12px;font-family:\"Oswald\",\"Arial Narrow\",Impact,sans-serif;font-size:clamp(1.25em,3.2cqi,1.9em);overflow-wrap:anywhere;line-height:1.15;text-transform:uppercase;letter-spacing:.01em}.tp-card__title a{color:inherit;text-decoration:none}.tp-card__text{margin:0 0 20px;color:#444;line-height:1.6}.tp-card__button{display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:999px;background:#1d1d1f;color:#fff;font-weight:700;text-decoration:none}.tp-card__button:hover{background:#000}@container (max-width:560px){.tp-card{grid-template-columns:minmax(0,1fr);gap:16px}.tp-card__media{max-width:260px}}"
  },
  "builder": null
}
