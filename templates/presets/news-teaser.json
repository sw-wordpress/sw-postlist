{
  "schema_version": 1,
  "id": "news-teaser",
  "title": "News teaser",
  "description": "Large image on the left, headline, categories and excerpt on the right.",
  "layout": {
    "type": "list",
    "gap": {
      "desktop": 28,
      "tablet": 20,
      "mobile": 16
    },
    "aspect_ratio": "3/2"
  },
  "container": {
    "html": "<section class=\"news\"><h2 class=\"news__heading\">{{view.title}}</h2>{{view.entries}}{{view.navigation}}</section>",
    "css": ".news__heading{margin-top:0}"
  },
  "entry": {
    "html": "<article class=\"teaser\">\n  {{#entry.image}}<a class=\"teaser__media\" href=\"{{entry.url}}\">{{entry.image|image:\"medium\"}}</a>{{/entry.image}}\n  <div class=\"teaser__body\">\n    {{#entry.terms.category}}<p class=\"teaser__cats\">{{entry.terms.category|join:\" · \"}}</p>{{/entry.terms.category}}\n    <h3 class=\"teaser__title\"><a href=\"{{entry.url}}\">{{entry.title}}</a></h3>\n    {{#entry.excerpt}}<p>{{entry.excerpt|words:35}}</p>{{/entry.excerpt}}\n    <a class=\"teaser__more\" href=\"{{entry.url}}\">Read more</a>\n  </div>\n</article>",
    "css": ".teaser{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:1em;align-items:start}\n.teaser__media img{width:100%;height:auto;aspect-ratio:var(--swp-aspect,3/2);object-fit:cover;display:block}\n.teaser__cats{margin:0;font-size:.8em;text-transform:uppercase;letter-spacing:.04em;opacity:.7}\n.teaser__title{margin:.2em 0}\n.teaser__title a{color:inherit;text-decoration:none}\n@media (max-width:640px){.teaser{grid-template-columns:minmax(0,1fr)}}"
  },
  "builder": null
}
