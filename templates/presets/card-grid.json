{
  "schema_version": 1,
  "id": "card-grid",
  "title": "Card grid",
  "description": "Responsive cards with image, title, date and excerpt.",
  "layout": {
    "type": "grid",
    "columns": {
      "desktop": 3,
      "tablet": 2,
      "mobile": 1
    },
    "gap": {
      "desktop": 24,
      "tablet": 16,
      "mobile": 12
    },
    "aspect_ratio": "16/9"
  },
  "container": {
    "html": "<div class=\"cards\">{{view.entries}}</div>\n{{view.navigation}}",
    "css": ".cards{display:block}"
  },
  "entry": {
    "html": "<article class=\"card\">\n  {{#entry.image}}<a class=\"card__media\" href=\"{{entry.url}}\">{{entry.image|image:\"medium_large\"}}</a>{{/entry.image}}\n  <div class=\"card__body\">\n    <h3 class=\"card__title\"><a href=\"{{entry.url}}\">{{entry.title}}</a></h3>\n    <time class=\"card__date\" datetime='{{entry.date|date:\"c\"}}'>{{entry.date|date}}</time>\n    {{#entry.excerpt}}<p class=\"card__excerpt\">{{entry.excerpt|words:30}}</p>{{/entry.excerpt}}\n  </div>\n</article>",
    "css": ".card{border:1px solid rgba(0,0,0,.12);border-radius:8px;overflow:hidden;background:#fff;height:100%}\n.card__media img{display:block;width:100%;height:auto;aspect-ratio:var(--swp-aspect,16/9);object-fit:cover}\n.card__body{padding:1em;display:flex;flex-direction:column;gap:.5em}\n.card__title{margin:0;font-size:1.1em}\n.card__title a{color:inherit;text-decoration:none}\n.card__date{font-size:.85em;opacity:.7}\n.card__excerpt{margin:0}"
  },
  "builder": null
}
